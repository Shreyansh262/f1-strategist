# ── Virtual environment ───────────────────────────────────────────────────────
venv/
.venv/
env/

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyc
*$py.class

# ── Data — never commit raw parquet files ─────────────────────────────────────
# (data/* + exceptions instead of data/ — git cannot re-include children of an
#  ignored directory; mappings + pit_loss are small required serving artifacts)
data/*
!data/mappings/
!data/pit_loss.json

# ── FastF1 cache — large binary files ─────────────────────────────────────────
cache/

# ── Trained model binaries ────────────────────────────────────────────────────
models/*.joblib
models/*.pkl
models/*.pt
models/*.ckpt

# ── Artifact bundles (downloaded from Kaggle/server) ──────────────────────────
*.zip

# ── MLflow experiment tracking ────────────────────────────────────────────────
mlruns/

# ── Lightning logs (created by local CPU predict/recalibrate runs) ────────────
lightning_logs/

# ── Reports — generated artefacts (optional: remove if you want them in repo) ─
# reports/

# ── Environment variables ─────────────────────────────────────────────────────
.env
.env.*

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── VS Code ───────────────────────────────────────────────────────────────────
.vscode/

# ── Build / packaging ─────────────────────────────────────────────────────────
*.egg-info/
dist/
build/
*.egg

# ── Pytest ────────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/cache/
